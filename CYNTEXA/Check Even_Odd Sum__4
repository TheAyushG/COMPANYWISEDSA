#include <iostream>
using namespace std;

int main(){

    int arr[] = {54, 21, 4, 84, 32, 23};

    int n = sizeof(arr) / sizeof(arr[0]);

    int evenSum = 0;
    int oddSum = 0;

    for(int i=0; i<n; i++){
        if(arr[i] % 2 == 0){
            evenSum += arr[i];
        }
        else {
            oddSum += arr[i];
        }
    }

    cout << "Even Sum is : " << evenSum << endl;
    cout << "Odd Sum is : " << oddSum << endl;

    return 0;
}
